# === База ===
DATABASE_URL=postgresql+psycopg2://bridge:bridge@postgres:5432/bridge
SECRET_KEY=change-me-use-long-random-string
ADMIN_PASSWORD=admin

# Порт админки на хосте (8080 часто занят другими проектами)
BRIDGE_HTTP_PORT=8091

# === Режим (пилот: только смотрим, не пишем) ===
DRY_RUN=true
CREATE_EVENTS_ENABLED=false
OUTGOING_SEND_ENABLED=false
SCHEDULER_ENABLED=true

# === IMAP / CalDAV ===
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
CALDAV_URL=https://caldav.yandex.ru
LOOKBACK_DAYS=14
CALENDAR_NAME=Основной

# === SMTP (для исходящих .ics, задача 2) ===
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# === Интервалы задач (сек) ===
INCOMING_INTERVAL_SECONDS=120
OUTGOING_INTERVAL_SECONDS=300
AUDIT_INTERVAL_SECONDS=600

# Домены внешних организаций (только для первого seed в БД; дальше — раздел «Организации»)
EXTERNAL_DOMAIN_ALLOWLIST=sberbank.ru,vtb.ru,mail.ru,raiffeisen.ru

# === Legacy pilot (один ящик через bridge/pilot.py) ===
YANDEX_LOGIN=
YANDEX_APP_PASSWORD=
YANDEX_CALENDAR_APP_PASSWORD=
