#jinja2: lstrip_blocks: "True"
{% for param in openconnecthost_ocserv_config_per_group[item] %}
    {% set param_name = param | replace('_','-') -%}
    {% if openconnecthost_ocserv_config_per_group[item][param] is iterable and openconnecthost_ocserv_config_per_group[item][param] is not string and openconnecthost_ocserv_config_per_group[item][param] is not mapping %}
        {% for entry in openconnecthost_ocserv_config_per_group[item][param] %}
{{ param }} = {{ entry }}
        {% endfor %}
    {% else %}
{{ param_name }} = {{ openconnecthost_ocserv_config_per_group[item][param] }}
    {% endif %}
{% endfor %}